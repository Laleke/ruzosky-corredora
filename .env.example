# Supabase — obtener en el dashboard del proyecto (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Service role: SOLO uso server-side (Edge Functions, scripts admin). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# URL pública del sitio (usada para armar el link de invitación al portal).
NEXT_PUBLIC_SITE_URL=https://tu-dominio.cl

# --- Notificaciones push (Web Push / VAPID) ---
# Generar un par con:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# La pública va al navegador (NEXT_PUBLIC_); la privada NUNCA se expone al cliente.
# Sin estas variables la app funciona igual, solo no envía notificaciones.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:eduardo.ruz.c@gmail.com
